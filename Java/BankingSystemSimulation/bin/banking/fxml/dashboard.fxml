<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="banking.controller.DashboardController"
      spacing="15"
      prefWidth="800" 
      prefHeight="600">

    <!-- Correct padding -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="welcomeLabel" text="Welcome, " style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Logout" onAction="#handleLogout" style="-fx-font-size: 13px;"/>
    </HBox>

    <Label text="Your Accounts" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <ComboBox fx:id="accountComboBox" promptText="Select Account" prefWidth="300"/>

    <Label fx:id="balanceLabel" text="Balance: ₹ 0.00" 
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>

    <HBox spacing="10">
        <TextField fx:id="amountField" promptText="Enter Amount" prefWidth="150"/>
        <Button text="Deposit" onAction="#handleDeposit" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Withdraw" onAction="#handleWithdraw" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Create Savings Account" onAction="#handleCreateSavings"/>
        <Button text="Create Current Account" onAction="#handleCreateCurrent"/>
    </HBox>

    <Label text="Transaction History" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="transactionTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="200"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="200"/>
            <TableColumn fx:id="descColumn" text="Description" prefWidth="250"/>
        </columns>
    </TableView>
</VBox>