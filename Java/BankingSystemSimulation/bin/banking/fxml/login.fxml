<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="banking.controller.LoginController"
      alignment="CENTER" 
      spacing="15" 
      prefWidth="420" 
      prefHeight="340">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Banking System" 
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Login" style="-fx-font-size: 18px;"/>

    <TextField fx:id="usernameField" promptText="Username" prefWidth="280"/>
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="280"/>

    <Button fx:id="loginButton" text="Login" 
            onAction="#handleLogin" 
            prefWidth="180" style="-fx-font-size: 14px;"/>

    <Button fx:id="registerButton" text="New User? Register Here" 
            onAction="#handleRegister" 
            prefWidth="180" 
            style="-fx-font-size: 14px; -fx-background-color: #2196F3; -fx-text-fill: white;"/>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red; -fx-font-size: 13px;"/>
</VBox>